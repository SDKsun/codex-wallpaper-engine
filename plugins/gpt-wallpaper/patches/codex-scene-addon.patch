+      return new ProcessResult(process.ExitCode, Snapshot(output), Snapshot(error));
+    }
+    finally
+    {
+      drainCancellation.Cancel();
+      // Inherited pipe handles can hold a reader open after command exit.
+      // Cleanup must not turn the launch deadline into an unbounded wait.
+      Observe(Task.Run(() =>
+      {
+        try
+        {
+          try { process.StandardOutput.Dispose(); } catch (InvalidOperationException) { }
+          catch (IOException) { }
+          try { process.StandardError.Dispose(); } catch (InvalidOperationException) { }
+          catch (IOException) { }
+        }
+        finally { process.Dispose(); drainCancellation.Dispose(); }
+      }));
+    }
+  }
