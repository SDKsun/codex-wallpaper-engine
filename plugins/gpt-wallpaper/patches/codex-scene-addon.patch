+      var valid = JsonSerializer.Serialize(new { usableVerifiedCdp = true, port = 9335,
+        browserId = Guid.NewGuid().ToString("D"), ownerProcessId = Environment.ProcessId,
+        ownerStartedAt = DateTimeOffset.UtcNow.ToString("O"), profilePath = Path.Combine(stateRoot, "cdp-profile") });
+      if (ParseIdentity(valid, stateRoot) is not { } parsed || ReadOwner(parsed) is not null ||
+          ParseIdentity(valid.Replace("9335", "9336"), stateRoot) is not null ||
+          ParseIdentity(valid.Replace("\"usableVerifiedCdp\":true", "\"usableVerifiedCdp\":false"), stateRoot) is not null ||
+          ParseIdentity(valid.Replace("\"port\":9335", "\"port\":9335,\"port\":9335"), stateRoot) is not null ||
+          ParseIdentity(valid.Replace("cdp-profile", "other-profile"), stateRoot) is not null ||
+          ParseIdentity(valid.Replace(parsed.BrowserId, "not-a-browser-id"), stateRoot) is not null ||
+          ParseIdentity("{}", stateRoot) is not null || ParseIdentity(new string('x', 8193), stateRoot) is not null ||
+          ValidLauncherPath(@"\\server\CodexDreamSkinManager.exe") is not null ||
+          ValidLauncherPath("C:\\not-a-launcher.exe\n") is not null ||
+          IsOwnedWindow(IntPtr.Zero, Environment.ProcessId, false)) return false;
+      using var fixture = new Form { ShowInTaskbar = false };
+      var window = fixture.Handle;
+      var launcher = Environment.ProcessPath!;
+      if (IsOwnedWindow(window, Environment.ProcessId + 1, false) || IsOwnedWindow(window, Environment.ProcessId, true)) return false;
+      var fixtureAppId = "CodexWallpaperEngine.Fixture." + Guid.NewGuid().ToString("N");
+      SetProperties(window, Environment.ProcessId, launcher, launcher, requireChrome: false, appId: fixtureAppId);
+      var iid = PropertyStoreId;
+      Marshal.ThrowExceptionForHR(SHGetPropertyStoreForWindow(window, ref iid, out var store));
+      try
+      {
+        var passed = ReadString(store, 2) == '"' + launcher + "\" --launch" && ReadString(store, 3) == launcher + ",0" &&
+          ReadString(store, 4) == "Codex（装扮）" && ReadString(store, 5) == fixtureAppId;
+        for (uint id = 2; id <= 5; id++)
+        {
+          var key = new PropertyKey { FormatId = PropertyGroup, PropertyId = id };
+          var empty = new PropVariant();
+          Marshal.ThrowExceptionForHR(store.SetValue(ref key, ref empty));
+        }
+        return passed && ReadString(store, 5) is null;
+      }
