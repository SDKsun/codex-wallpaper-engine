+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import path from "node:path";
+import os from "node:os";
+import http from "node:http";
+import vm from "node:vm";
+import {createHash} from "node:crypto";
+import {
+  normalizeDshNativeConfig, readDshNativeAddon, dshNativeOrigin, mapDshProxyUrl,
+  installDshProxy as installDshProxyWithLogs, applyToSession, runOneShot, verifySession, loadPayload, dshRequestBodyLimit,
+  installDshBinding, DSH_NATIVE_BINDING,
+  isDshPackageResource,
+} from "../scripts/injector.mjs";
+
+const token = "a".repeat(64);
+const digest = "b".repeat(64);
+const config = (origin = "http://127.0.0.1:18765") => ({enabled: true, origin, token, scriptHash: digest});
+const installDshProxy = (target, value, options = {}) => installDshProxyWithLogs(target, value, {onDiagnostic: () => {}, ...options});
+
+function session(targetUrl = "app://codex/index.html") {
+  const handlers = new Map();
+  return {
+    target: {url: targetUrl}, closed: false, messages: [], evaluations: [],
+    executionContexts: new Map([[1, {id: 1, origin: dshNativeOrigin(targetUrl), auxData: {isDefault: true, frameId: "main-frame"}}]]),
+    on(name, callback) { handlers.set(name, callback); },
+    off(name, callback) { if (handlers.get(name) === callback) handlers.delete(name); },
+    async send(method, params = {}) {
+      this.messages.push({method, params});
+      if (method === "Page.getFrameTree") return {frameTree: {frame: {id: "main-frame", url: targetUrl}}};
+      if (method === "Browser.getWindowForTarget") return {windowId: 1, bounds: {width: 900, height: 700, windowState: "normal"}};
+      if (method === "Browser.getWindowBounds") return {bounds: {width: 900, height: 700, windowState: "normal"}};
+      return {};
+    },
+    async evaluate(expression) { this.evaluations.push(expression); return {visible: true, pass: true}; },
+    close() { this.closed = true; },
+  };
+}
+
+function paused(relative, {method = "GET", headers = {}, postData, hasPostData, postDataEntries} = {}) {
+  return {requestId: "request-1", request: {url: `app://codex/dsh/${token}/${relative}`, method, headers, postData, hasPostData, postDataEntries}};
+}
+
+function fulfilled(target) {
+  const message = target.messages.findLast(item => item.method === "Fetch.fulfillRequest");
+  assert.ok(message, "Expected an intercepted response");
+  return {...message.params, bytes: Buffer.from(message.params.body, "base64")};
+}
+
+test("native DSH config and app-origin parsing reject other origins and unsafe states", () => {
+  assert.deepEqual(normalizeDshNativeConfig(config()), config());
+  assert.equal(normalizeDshNativeConfig({enabled: false}), null);
+  for (const input of [null, [], {}, {enabled: 1}, {...config(), extra: "x"},
+    {...config(), origin: "http://localhost:18765"}, {...config(), origin: "https://127.0.0.1:18765"},
+    {...config(), origin: "http://127.0.0.1:80"}, {...config(), origin: "http://127.0.0.1:018765"},
+    {...config(), origin: "http://127.0.0.1:18765/path"}, {...config(), token: "short"},
+    {...config(), scriptHash: "not-a-hash"}, Object.create(config()), JSON.parse('{"enabled":true,"__proto__":{}}')]) {
+    assert.throws(() => normalizeDshNativeConfig(input));
+  }
+  assert.equal(dshNativeOrigin("app://-/index.html?initialRoute=%2Fthread"), "app://-");
+  assert.equal(dshNativeOrigin("app://codex/"), "app://codex");
+  assert.equal(new URL("app://codex/").origin, "null", "Do not use URL.origin for the native scheme");
+  for (const input of ["https://codex/", "app://user@codex/", "app://codex:1234/", "app:///index.html"]) assert.throws(() => dshNativeOrigin(input));
+  assert.equal(mapDshProxyUrl(`app://codex/dsh/${token}/wallpaper-engine/settings?q=1`, "app://codex", config()), `http://127.0.0.1:18765/dsh/${token}/wallpaper-engine/settings?q=1`);
+  for (const input of [`app://other/dsh/${token}/settings`, `https://codex/dsh/${token}/settings`, `app://codex/dsh/${"c".repeat(64)}/settings`, "app://codex/index.html"]) {
+    assert.equal(mapDshProxyUrl(input, "app://codex", config()), null);
+  }
+  assert.throws(() => mapDshProxyUrl(`app://codex/dsh/${token}/%2fprivate`, "app://codex", config()));
+});
+
+test("fixed local factory requires exact SHA256, bounded plain configuration, and updates the watcher stamp", async () => {
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), "native-dsh-config-"));
+  const directory = path.join(temporary, "GPTWallpaper");
+  await fs.mkdir(directory);
+  try {
+    const source = "function(nativeOrigin){ return {nativeOrigin}; }";
+    const scriptHash = createHash("sha256").update(source).digest("hex");
+    await fs.writeFile(path.join(directory, "native-client.js"), source);
+    await fs.writeFile(path.join(directory, "dsh-native.json"), JSON.stringify({...config(), scriptHash}));
+    const first = await readDshNativeAddon(temporary);
+    assert.equal(first.source, source); assert.equal(first.config.scriptHash, scriptHash);
+    await fs.writeFile(path.join(directory, "native-client.js"), source + " ");
+    const mismatch = await readDshNativeAddon(temporary);
+    assert.equal(mismatch.config, null); assert.notEqual(mismatch.stamp, first.stamp);
+    await fs.writeFile(path.join(directory, "dsh-native.json"), "x".repeat(8193));
+    assert.equal((await readDshNativeAddon(temporary)).config, null);
+    await fs.writeFile(path.join(directory, "dsh-native.json"), JSON.stringify({enabled: false}));
+    assert.equal((await readDshNativeAddon(temporary)).config, null);
+    const outside = path.join(temporary, "redirected"); await fs.mkdir(outside);
+    await fs.writeFile(path.join(outside, "native-client.js"), source);
+    await fs.writeFile(path.join(outside, "dsh-native.json"), JSON.stringify({...config(), scriptHash}));
+    await fs.rename(directory, path.join(temporary, "original-state"));
+    // Junctions exercise the redirected-component boundary on Windows without
+    // relying on file-symlink privileges or substituting a weaker assertion.
+    await fs.symlink(outside, directory, process.platform === "win32" ? "junction" : "dir");
+    assert.equal((await readDshNativeAddon(temporary)).config, null);
+  } finally { await fs.rm(temporary, {recursive: true, force: true}); }
+});
+
+test("native addon fingerprint participates in loaded theme and revision without altering saved theme JSON", async () => {
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), "native-dsh-payload-"));
+  const before = process.env.LOCALAPPDATA;
+  process.env.LOCALAPPDATA = temporary;
+  const themeDirectory = path.join(temporary, "theme");
+  const addonDirectory = path.join(temporary, "GPTWallpaper");
+  await fs.mkdir(themeDirectory); await fs.mkdir(addonDirectory);
+  try {
+    await fs.copyFile(new URL("../assets/dream-reference.jpg", import.meta.url), path.join(themeDirectory, "poster.jpg"));
+    const theme = JSON.stringify({schemaVersion: 1, id: "native-test", image: "poster.jpg"});
+    await fs.writeFile(path.join(themeDirectory, "theme.json"), theme);
+    const plain = await loadPayload(themeDirectory);
+    const source = "function(nativeOrigin){return {nativeOrigin};}";
+    const scriptHash = createHash("sha256").update(source).digest("hex");
+    await fs.writeFile(path.join(addonDirectory, "native-client.js"), source);
+    await fs.writeFile(path.join(addonDirectory, "dsh-native.json"), JSON.stringify({...config(), scriptHash}));
+    const native = await loadPayload(themeDirectory);
+    assert.equal(native.dshNative.source, source);
+    assert.notEqual(native.fingerprint, plain.fingerprint); assert.notEqual(native.sourceStamp, plain.sourceStamp); assert.notEqual(native.revision, plain.revision);
+    assert.equal(await fs.readFile(path.join(themeDirectory, "theme.json"), "utf8"), theme);
+  } finally {
+    if (before === undefined) delete process.env.LOCALAPPDATA; else process.env.LOCALAPPDATA = before;
+    await fs.rm(temporary, {recursive: true, force: true});
+  }
+});
+
+test("proxy rewrites only the authenticated text base, preserves binary bytes and never forwards cookies", async () => {
+  const seen = [];
+  let origin;
+  const server = http.createServer(async (request, response) => {
+    let body = ""; for await (const bytes of request) body += bytes;
+    seen.push({url: request.url, method: request.method, headers: request.headers, body});
+    if (request.url.endsWith("/binary")) {
+      response.writeHead(200, {"Content-Type": "application/octet-stream"}); response.end(Buffer.from([0, 255, 1, 128]));
+    } else if (request.url.endsWith("/redirect")) {
+      response.writeHead(302, {Location: "https://example.invalid/"}); response.end();
+    } else {
+      response.writeHead(200, {"Content-Type": "application/json; charset=utf-8", "Set-Cookie": "secret=value", ETag: "old", Location: "https://outside.invalid/"});
+      response.end(JSON.stringify({url: `${origin}/dsh/${token}/wallpaper-engine/media/file`, untouched: `${origin}/outside`}));
+    }
+  });
+  await new Promise(resolve => server.listen(0, "127.0.0.1", resolve));
+  origin = `http://127.0.0.1:${server.address().port}`;
+  const target = session();
+  const proxy = await installDshProxy(target, config(origin));
+  try {
+    assert.deepEqual(target.messages[0], {method: "Fetch.enable", params: {patterns: [{urlPattern: `app://codex/dsh/${token}/*`, requestStage: "Request"}]}});
+    await proxy.handlePaused(paused("wallpaper-engine/settings", {method: "PATCH", headers: {"Content-Type": "application/json", Cookie: "private", Authorization: "Bearer private", Origin: "app://codex"}, postData: '{"blur":20}'}));
+    const response = fulfilled(target); const json = JSON.parse(response.bytes.toString());
+    assert.equal(response.responseCode, 200); assert.equal(json.url, `app://codex/dsh/${token}/wallpaper-engine/media/file`); assert.equal(json.untouched, `${origin}/outside`);
