+  };
+  const proxy = await installDshProxy(target, config(), {fetchImpl});
+  binding = await installDshBinding(target, config(), {proxy});
+  const call = (payload, executionContextId = 1) => binding.handleCalled({name: DSH_NATIVE_BINDING, executionContextId, payload: JSON.stringify(payload)});
+  return {target, proxy, binding, replies, call, dispose: async () => {await binding.dispose(); await proxy.dispose();}};
