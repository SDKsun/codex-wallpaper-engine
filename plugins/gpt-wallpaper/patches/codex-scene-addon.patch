+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import path from "node:path";
+import os from "node:os";
+import { fileURLToPath } from "node:url";
+import { loadPayload, normalizeSceneAddon, readSceneAddon } from "../scripts/injector.mjs";
+
+const url = `http://127.0.0.1:18765/s/${"a".repeat(64)}/scene/${"b".repeat(24)}`;
+test("scene addon only accepts exact authenticated loopback frame URLs", () => {
+  assert.equal(normalizeSceneAddon({ enabled: true, url, name: "本地场景" }), url);
+  assert.equal(normalizeSceneAddon({ enabled: false }), null);
+  for (const value of [null, [], {}, { enabled: 1 }, { enabled: true, url, command: "x" },
+    { enabled: true, url, name: "x\n" }, { enabled: true, url: url + "?token=x" },
+    { enabled: true, url: url + "#fragment" }, { enabled: true, url: " " + url },
+    { enabled: true, url: url.replace("127.0.0.1", "localhost") },
+    { enabled: true, url: url.replace("127.0.0.1", "127.0.0.2") },
+    { enabled: true, url: url.replace("18765", "80") },
+    { enabled: true, url: url.replace("http:", "https:") },
+    { enabled: true, url: url.replace("/scene/", "/other/") },
+    { enabled: true, url: url.replace("a".repeat(64), "short") },
+    { enabled: true, url: url.replace("127.0.0.1", "user@127.0.0.1") },
+  ]) assert.throws(() => normalizeSceneAddon(value));
+});
+
+test("addon state changes invalidate watcher fingerprints without changing persisted theme schema", async () => {
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), "dreamskin-scene-addon-"));
+  const originalLocal = process.env.LOCALAPPDATA;
+  process.env.LOCALAPPDATA = temporary;
+  const root = path.dirname(fileURLToPath(new URL("../assets/", import.meta.url)));
+  const themeDir = path.join(temporary, "theme");
+  const configDir = path.join(temporary, "GPTWallpaper");
+  const configFile = path.join(configDir, "scene.json");
+  try {
+    await fs.mkdir(themeDir); await fs.mkdir(configDir);
+    await fs.copyFile(path.join(root, "assets", "dream-reference.jpg"), path.join(themeDir, "poster.jpg"));
+    const themeText = JSON.stringify({ schemaVersion: 1, id: "scene-fixture", image: "poster.jpg" });
+    await fs.writeFile(path.join(themeDir, "theme.json"), themeText);
