+namespace CodexDreamSkin.Manager;
+
+// The wallpaper shortcut starts a managed Codex session, rather than a second
+// settings window. Merely reopening the official Store entry cannot add CDP
+// switches to an already-running normal Codex process.
+internal static class CodexLauncher
+{
+  private const string ProductName = "Codex 动态壁纸";
+  private const int OutputLimit = 64 * 1024;
+  private static readonly TimeSpan LibraryTimeout = TimeSpan.FromSeconds(45);
+
+  public static int Run(bool interactive = true)
+  {
+    Application.SetHighDpiMode(HighDpiMode.PerMonitorV2);
+    Application.EnableVisualStyles();
+    Application.SetCompatibleTextRenderingDefault(false);
+    using var gate = new Mutex(false, @"Local\CodexDreamSkin.Launcher");
+    var acquired = false;
+    try
+    {
+      try { acquired = gate.WaitOne(0); }
+      catch (AbandonedMutexException) { acquired = true; }
+      // A second click while the same launcher is working must not start a
+      // competing extraction, resource service or PowerShell operation.
+      if (!acquired) return 0;
+
+      var runtime = new RuntimeProvisioner();
+      runtime.EnsureExtracted();
+      using var service = new DreamSkinService(runtime)
+      {
+        ConfirmCodexRestart = interactive ? ConfirmRestart : _ => false,
+      };
+      RunFlowAsync(
+        () => EnsureLibraryAsync(runtime),
+        () => service.StartAsync()).GetAwaiter().GetResult();
+      try { TaskbarRelaunch.ApplyAsync(runtime).GetAwaiter().GetResult(); }
+      catch
+      {
+        // Relaunch metadata is optional. A verified visible wallpaper window
+        // remains a successful launch even if Windows rejects these properties.
+      }
+      return 0;
+    }
+    catch (OperationCanceledException)
+    {
+      // The restart confirmation already explained this decision. In
+      // particular, cancelling must not reopen or replace a normal instance.
+      return 2;
+    }
+    catch (Exception exception)
+    {
+      WriteFailure(exception);
+      // A background automatic launch must finish with its real exit code;
+      // waiting for an invisible error dialog strands the assistant for minutes.
+      if (interactive)
+        MessageBox.Show(
+          "装扮启动未完成。请查看壁纸诊断日志中的详细原因。",
+          ProductName, MessageBoxButtons.OK, MessageBoxIcon.Error);
+      return 1;
+    }
+    finally
+    {
+      if (acquired) gate.ReleaseMutex();
+    }
+  }
+
+  private static bool ConfirmRestart(string message)
+  {
+    // StartAsync can resume on a pool thread after its read-only preflight.
+    // Keep any required native confirmation on an STA thread, without adding
+    // an unconditional RestartExisting path to the normal shortcut.
+    var approved = false;
+    Exception? failure = null;
+    var prompt = new Thread(() =>
+    {
+      try
+      {
+        approved = MessageBox.Show(message, ProductName, MessageBoxButtons.YesNo,
+          MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) == DialogResult.Yes;
+      }
+      catch (Exception exception) { failure = exception; }
+    });
