+        processId = fresh.ProcessId, startedAt = fresh.StartedAt.ToString("O"), reason = "identity_changed", closeRequested = false, windowRestored = false });
+      if (!ReadTakeover(success, fresh, out _, out var closedRequest, out _) || !closedRequest ||
+          ReadTakeover(success, other, out _, out _, out _) ||
+          ReadTakeover(refused, fresh, out _, out _, out _)) return false;
+      try { ReadTakeover(refused.Replace("\"windowRestored\":false", "\"windowRestored\":true"), fresh, out _, out _, out _); return false; } catch (JsonException) { }
+
+      fixture = Path.Combine(Path.GetTempPath(), "codex-assistant-test-" + Guid.NewGuid().ToString("N"));
+      Directory.CreateDirectory(fixture);
