+          if (Directory.Exists(runtime.ScriptsRoot)) Directory.Delete(runtime.ScriptsRoot, false);
+          Directory.Delete(runtime.PayloadRoot, false);
+          Directory.Delete(node, false);
+          Directory.Delete(runtime.RuntimeRoot, false);
