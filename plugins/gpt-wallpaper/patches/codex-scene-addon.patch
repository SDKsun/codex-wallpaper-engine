+    $current=Get-DreamSkinManagedWindowIdentity -Codex $Codex -Port $Port -BrowserId $BrowserId -ProfilePath $ProfilePath
+    if ($null -eq $current -or $current.ProcessId -ne $before.ProcessId -or $current.StartedAt -cne $before.StartedAt -or $current.SessionId -ne $before.SessionId) { return $false }
+    if ($allWindows.Count -eq 1 -and -not $ReactivateProfile) {
