+test("large package requests serialize and disposal removes interception", async () => {
+  const pending = [];
+  let active = 0, maximum = 0;
+  const target = session();
+  const proxy = await installDshProxy(target, config(), {fetchImpl: async () => {
+    active += 1; maximum = Math.max(maximum, active);
+    await new Promise(resolve => pending.push(resolve)); active -= 1;
+    return new Response("pkg", {headers: {"Content-Type": "application/octet-stream"}});
+  }});
+  const encodedPackage = name => `wallpaper-engine/scene-files/${Buffer.from(`Z:\\unregistered\\${name}.pkg`).toString("base64url")}`;
+  const first = proxy.handlePaused(paused(encodedPackage("scene")));
+  const second = proxy.handlePaused({...paused(encodedPackage("other")), requestId: "request-2"});
+  await new Promise(resolve => setImmediate(resolve));
+  assert.equal(pending.length, 1); pending.shift()();
+  await first; await new Promise(resolve => setImmediate(resolve));
+  assert.equal(pending.length, 1); pending.shift()(); await second;
+  assert.equal(maximum, 1);
+  await proxy.dispose(); assert.equal(target.messages.at(-1).method, "Fetch.disable");
+  assert.equal(target.dreamSkinDshProxy, undefined);
+});
+
+test("native factory boots exclusively with app origin and never enables CSP bypass", async () => {
+  const target = session("app://-/index.html?initialRoute=/thread");
+  const source = "function(nativeOrigin){return {nativeOrigin};}";
+  await applyToSession(target, {payload: "old-renderer", revision: "revision-1", mediaType: "video", dshNative: {config: config(), source}});
+  assert.equal(target.dshNativeDesired, true);
+  assert.equal(target.evaluations.some(value => value === "old-renderer"), false);
+  assert.equal(target.evaluations.some(value => value.includes('(\"app://-\")')), true);
+  assert.equal(target.evaluations.some(value => value.includes("transportRevision")), true);
+  assert.equal(target.messages.some(value => value.method === "Page.setBypassCSP" && value.params.enabled), false);
+  await target.dreamSkinDshProxy.dispose();
+  await assert.rejects(applyToSession(session(), "payload-only"), /complete loaded/);
+});
