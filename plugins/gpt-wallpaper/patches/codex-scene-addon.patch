+test("addon state changes invalidate watcher fingerprints without changing persisted theme schema", async () => {
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), "dreamskin-scene-addon-"));
+  const originalLocal = process.env.LOCALAPPDATA;
+  process.env.LOCALAPPDATA = temporary;
+  const root = path.dirname(fileURLToPath(new URL("../assets/", import.meta.url)));
+  const themeDir = path.join(temporary, "theme");
+  const configDir = path.join(temporary, "GPTWallpaper");
+  const configFile = path.join(configDir, "scene.json");
+  try {
+    await fs.mkdir(themeDir); await fs.mkdir(configDir);
+    await fs.copyFile(path.join(root, "assets", "dream-reference.jpg"), path.join(themeDir, "poster.jpg"));
+    const themeText = JSON.stringify({ schemaVersion: 1, id: "scene-fixture", image: "poster.jpg" });
+    await fs.writeFile(path.join(themeDir, "theme.json"), themeText);
+    const original = await loadPayload(themeDir);
+    assert.equal(original.theme.sceneLiveUrl, undefined);
+    await fs.writeFile(configFile, JSON.stringify({ enabled: true, url }));
+    const first = await loadPayload(themeDir);
+    assert.equal(first.theme.sceneLiveUrl, url);
+    assert.notEqual(first.fingerprint, original.fingerprint);
+    assert.notEqual(first.sourceStamp, original.sourceStamp);
+    assert.notEqual(first.revision, original.revision);
+    const secondUrl = url.replace("b".repeat(24), "c".repeat(24));
+    const previousStat = await fs.stat(configFile);
+    await fs.writeFile(configFile, JSON.stringify({ enabled: true, url: secondUrl }));
+    await fs.utimes(configFile, previousStat.atime, previousStat.mtime);
+    const second = await loadPayload(themeDir);
+    assert.notEqual(second.fingerprint, first.fingerprint, "Same-sized changes must invalidate the payload even with restored mtime");
+    assert.notEqual(second.sourceStamp, first.sourceStamp);
+    assert.equal(await fs.readFile(path.join(themeDir, "theme.json"), "utf8"), themeText);
+    await fs.writeFile(configFile, JSON.stringify({ enabled: false }));
+    assert.equal((await loadPayload(themeDir)).theme.sceneLiveUrl, undefined);
+    await fs.writeFile(configFile, "{");
+    assert.equal((await readSceneAddon()).url, null);
+    await fs.writeFile(configFile, "x".repeat(8193));
+    assert.equal((await readSceneAddon()).url, null);
+    await fs.writeFile(configFile, JSON.stringify({ enabled: true, url }));
+    await fs.writeFile(path.join(themeDir, "theme.json"), JSON.stringify({
+      schemaVersion: 1, id: "legacy-stream-fixture", image: "poster.jpg",
+      media: { type: "scene", codec: "avc1.42c01f", streamUrl: "http://127.0.0.1:18766/1234567890abcdef1234567890abcdef/stream.mp4" },
+    }));
+    const legacy = await loadPayload(themeDir);
+    assert.equal(legacy.mediaType, "image");
+    assert.equal(legacy.mediaStreamUrl, null, "Iframe addon must not inherit legacy global CSP bypass");
+    assert.equal(legacy.theme.media.streamUrl, undefined);
+  } finally {
+    if (originalLocal === undefined) delete process.env.LOCALAPPDATA;
+    else process.env.LOCALAPPDATA = originalLocal;
+    await fs.rm(temporary, { recursive: true, force: true });
+  }
+});
