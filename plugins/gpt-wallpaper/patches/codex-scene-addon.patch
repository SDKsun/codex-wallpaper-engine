+function Get-DreamSkinManagedWindowIdentity {
+  param([object]$Codex, [int]$Port, [string]$BrowserId, [string]$ProfilePath)
+  if (-not $BrowserId -or -not $ProfilePath) { return $null }
+  $listeners = @(Get-DreamSkinPortListeners -Port $Port)
+  if ($listeners.Count -eq 0 -or @($listeners | Where-Object { $_.LocalAddress -notin @('127.0.0.1','::1') }).Count) { return $null }
+  $owners = @($listeners | Select-Object -ExpandProperty OwningProcess -Unique)
+  if ($owners.Count -ne 1) { return $null }
+  $process = Get-CimInstance Win32_Process -Filter "ProcessId = $([int]$owners[0])" -ErrorAction SilentlyContinue
+  if (-not $process -or -not $process.CreationDate -or -not $process.CommandLine) { return $null }
+  if (-not (Test-DreamSkinPathEqual -Left (Get-DreamSkinProcessExecutablePath -ProcessInfo $process) -Right $Codex.Executable)) { return $null }
+  $arguments = @(Get-DreamSkinManagedWindowArguments -CommandLine $process.CommandLine)
+  $profiles = @()
+  for ($i=1; $i -lt $arguments.Count; $i++) {
+    if ($arguments[$i] -eq '--user-data-dir' -and $i+1 -lt $arguments.Count) { $profiles += $arguments[++$i] }
+    elseif ($arguments[$i].StartsWith('--user-data-dir=')) { $profiles += $arguments[$i].Substring(16) }
+  }
+  if ($profiles.Count -ne 1 -or -not (Test-DreamSkinPathEqual -Left $profiles[0] -Right $ProfilePath)) { return $null }
+  # A closed last window can leave the managed browser alive with no page
+  # targets. Browser/owner/profile identity is still sufficient for a normal
+  # same-profile activation, but never for renderer-success verification.
+  $identity = Get-DreamSkinCdpBrowserIdentity -Port $Port
+  if ($null -eq $identity -or $identity.BrowserId -cne $BrowserId) { return $null }
+  if (-not (Test-DreamSkinCodexPortOwner -Port $Port -Codex $Codex)) { return $null }
+  return [pscustomobject]@{ ProcessId=[int]$process.ProcessId; StartedAt=$process.CreationDate.ToUniversalTime().ToString('o'); SessionId=$process.SessionId }
+}
+
+function Get-DreamSkinRecoverableCdpIdentityForAnyRegistered {
+  param([int]$Port, [string]$ProfilePath)
+  foreach ($install in @(Get-DreamSkinRegisteredCodexInstalls)) {
+    $identity = Get-DreamSkinCdpBrowserIdentity -Port $Port
+    if ($null -eq $identity) { return $null }
+    $owner = Get-DreamSkinManagedWindowIdentity -Codex $install -Port $Port `
+      -BrowserId $identity.BrowserId -ProfilePath $ProfilePath
+    if ($null -ne $owner) {
+      return [pscustomobject]@{ Codex=$install; Identity=[pscustomobject]@{
+        BrowserId=$identity.BrowserId; BrowserWebSocketDebuggerUrl=$identity.WebSocketDebuggerUrl
+        Browser=$identity.Browser; TargetCount=@(Get-DreamSkinCdpTargets -Port $Port).Count
+      } }
+    }
+  }
+  return $null
+}
