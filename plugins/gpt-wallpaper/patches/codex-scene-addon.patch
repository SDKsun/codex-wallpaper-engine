+test("one-shot apply passes the complete loaded payload and does not steal native watcher Fetch", async () => {
+  const beforeExit = process.exitCode;
+  const beforeLog = console.log;
+  const target = session();
+  const loaded = {payload: "CANARY_RENDERER_PAYLOAD", revision: "r1", mediaType: "image", theme: {id: "fixture", name: "Fixture"}};
+  const dependencies = {connectTargets: async () => [{target: {id: "fixture"}, session: target, probe: {markers: {}}}], loadPayload: async () => loaded};
+  console.log = () => {};
+  try {
+    await runOneShot({mode: "once", port: 1, browserId: "fixture", timeoutMs: 50}, dependencies);
+    assert.equal(target.evaluations.includes("CANARY_RENDERER_PAYLOAD"), true, "The old string-only call evaluated undefined instead of the renderer");
+    assert.equal(process.exitCode, beforeExit);
+    const native = session(); loaded.dshNative = {config: config(), source: "FACTORY_MUST_REMAIN_ON_WATCHER"};
+    await runOneShot({mode: "once", port: 1, browserId: "fixture", timeoutMs: 50}, {...dependencies, connectTargets: async () => [{target: {id: "fixture"}, session: native, probe: {markers: {}}}]});
+    assert.equal(native.messages.some(value => value.method === "Fetch.enable"), false);
+    assert.equal(native.evaluations.some(value => value.includes("FACTORY_MUST_REMAIN_ON_WATCHER")), false);
+  } finally { console.log = beforeLog; process.exitCode = beforeExit; }
