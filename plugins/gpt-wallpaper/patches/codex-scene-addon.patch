+  assert.equal(dshRequestBodyLimit(url("glass-presets/import"), "POST", config()), 128 * 1024 + 3 * Math.ceil((8 * 1024 * 1024) / 3) * 4);
+  assert.equal(dshRequestBodyLimit(url("settings"), "POST", config()), 1024 * 1024);
+  const bodies = [];
+  const target = session();
+  const proxy = await installDshProxy(target, config(), {fetchImpl: async (_url, options) => {
+    bodies.push(options.body); return new Response('{"ok":true}', {headers: {"Content-Type": "application/json"}});
+  }});
+  try {
+    const bytes = Buffer.alloc(2 * 1024 * 1024, 255); bytes[0] = 0; bytes[1] = 128; bytes[2] = 10;
+    await proxy.handlePaused(paused("wallpaper-engine/avatar/user", {method: "POST", headers: {"Content-Type": "image/png"}, postDataEntries: [{bytes: bytes.toString("base64")}]}));
+    assert.equal(fulfilled(target).responseCode, 200); assert.deepEqual(bodies.at(-1), bytes);
+    const before = bodies.length;
+    await proxy.handlePaused(paused("wallpaper-engine/upload", {method: "POST", headers: {"Content-Type": "video/mp4"}, hasPostData: true}));
+    assert.equal(fulfilled(target).responseCode, 422); assert.match(fulfilled(target).bytes.toString(), /native-upload-bytes-unavailable/);
+    await proxy.handlePaused(paused("wallpaper-engine/upload", {method: "POST", headers: {"Content-Type": "image/png"}, postData: "binary-as-text"}));
+    assert.equal(fulfilled(target).responseCode, 422); assert.equal(bodies.length, before);
+  } finally { await proxy.dispose(); }
+});
