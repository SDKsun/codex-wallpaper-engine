+        try { File.Delete(Path.Combine(fixture, "startup-assistant.json")); File.Delete(Path.Combine(fixture, "startup-assistant-install.json")); File.Delete(Path.Combine(fixture, "CodexDreamSkinManager.exe")); Directory.Delete(fixture, false); }
