+  private static void SetString(IPropertyStore store, uint id, string value)
+  {
+    var key = new PropertyKey { FormatId = PropertyGroup, PropertyId = id };
+    var variant = new PropVariant { Type = 31, Pointer = Marshal.StringToCoTaskMemUni(value) };
+    try { Marshal.ThrowExceptionForHR(store.SetValue(ref key, ref variant)); }
+    finally { Marshal.FreeCoTaskMem(variant.Pointer); }
+  }
