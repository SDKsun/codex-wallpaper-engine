+        $windows=@(Get-DreamSkinOwnedCodexWindows -ProcessId $before.ProcessId)
+        $allWindows=@(Get-DreamSkinOwnedCodexWindows -ProcessId $before.ProcessId -IncludeHidden)
+      } while ($allWindows.Count -eq 0 -and [DateTime]::UtcNow -lt $discoveryDeadline)
+    }
