+  }
+
+  private static async Task RunFlowAsync(Func<Task> ensureLibrary, Func<Task> startCodex)
+  {
+    await ensureLibrary().ConfigureAwait(false);
+    await startCodex().ConfigureAwait(false);
+  }
+
+  internal static async Task EnsureLibraryAsync(RuntimeProvisioner runtime)
+  {
+    var pluginRoot = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, ".."));
+    var script = Path.Combine(pluginRoot, "scripts", "server.mjs");
+    RequireLocalFile(script);
+    RequireLocalFile(runtime.NodePath);
+    var result = await RunLibraryCommandAsync(
+      CreateLibraryStartInfo(runtime.NodePath, script, ManagerLocalData.Root),
+      LibraryTimeout).ConfigureAwait(false);
