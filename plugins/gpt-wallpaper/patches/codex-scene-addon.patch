+
+  public static bool SelfTest()
+  {
+    string? fixture = null;
+    try
+    {
+      var now = DateTimeOffset.UtcNow;
+      if (RetryDelay(1).TotalSeconds != 15 || RetryDelay(2).TotalSeconds != 30 ||
+          RetryDelay(3).TotalSeconds != 60 || RetryDelay(int.MaxValue).TotalSeconds != 60) return false;
+      var fresh = new Root(1001, now.AddSeconds(-1), "normal", 1, true, true);
+      var controller = new Controller();
+      if (controller.Select(new(false, new[] { fresh }), now) != fresh) return false;
+      if (controller.Select(new(false, new[] { fresh with { VisibleWindow = false } }), now) is not null) return false;
+      if (controller.Select(new(false, new[] { fresh }), now) != fresh) return false;
+      if (controller.Select(new(true, new[] { fresh }), now) is not null) return false;
+      foreach (var invalid in new[] { fresh with { PlainLaunch = false }, fresh with { Kind = "unknown" },
+        fresh with { Kind = "managed" }, fresh with { AgeSeconds = 16 }, fresh with { StartedAt = now.AddSeconds(-16) } })
+        if (controller.Select(new(false, new[] { invalid }), now) is not null) return false;
+      var other = fresh with { ProcessId = 1002, StartedAt = now.AddMinutes(-1), AgeSeconds = 60 };
+      if (controller.Select(new(false, new[] { fresh, other }), now) is not null ||
+          controller.Select(new(false, new[] { fresh, other with { Kind = "unknown" } }), now) is not null ||
+          controller.Select(new(false, new[] { fresh, other with { Kind = "managed" } }), now) != fresh) return false;
+      controller.Attempt(fresh);
+      if (controller.Select(new(false, new[] { fresh }), now) is not null ||
+          controller.Select(new(false, new[] { fresh with { StartedAt = now.AddMilliseconds(-100) } }), now) is null) return false;
+      var retrying = new Controller();
+      retrying.Attempt(fresh);
+      if (retrying.Retry(fresh, "tree_changed", true, now) ||
+          retrying.Retry(fresh, "identity_changed", false, now) ||
+          !retrying.Retry(fresh, "tree_changed", false, now) ||
+          retrying.Select(new(false, new[] { fresh }), now) is not null ||
+          retrying.Select(new(false, new[] { fresh }), now.AddSeconds(1)) != fresh) return false;
+      retrying.Attempt(fresh);
+      if (!retrying.Retry(fresh, "operation_busy", false, now.AddSeconds(1))) return false;
+      retrying.Attempt(fresh);
+      if (retrying.Retry(fresh, "tree_changed", false, now.AddSeconds(2))) return false;
+      var expiredRetry = new Controller(); expiredRetry.Attempt(fresh);
+      if (expiredRetry.Retry(fresh, "tree_changed", false, now.AddSeconds(16))) return false;
+      var resumed = new Controller();
+      resumed.OnlyFutureLaunches(now);
+      if (resumed.Select(new(false, new[] { fresh }), now) is not null ||
+          resumed.Select(new(false, new[] { fresh with { StartedAt = now.AddSeconds(1) } }), now.AddSeconds(2)) is null) return false;
+
+      var snapshotJson = JsonSerializer.Serialize(new { schema = 1, operationBusy = false, registeredProcessCount = 2,
+        roots = new[] { new { processId = fresh.ProcessId, startedAt = fresh.StartedAt.ToString("O"),
+          kind = "normal", ageSeconds = 1, plainLaunch = true, visibleWindow = true } } });
+      if (ParseSnapshot(snapshotJson).Roots.Count != 1 || ParseSnapshot(snapshotJson).RegisteredProcessCount != 2) return false;
+      foreach (var invalid in new[] { "{}", snapshotJson.Replace("\"schema\":1", "\"schema\":1,\"schema\":1"),
+        snapshotJson.Replace("\"visibleWindow\":true", "\"visibleWindow\":\"yes\""),
+        snapshotJson.Replace("\"normal\"", "\"untrusted\""),
+        snapshotJson.Replace("\"registeredProcessCount\":2", "\"registeredProcessCount\":0"),
+        new string('x', MaximumJsonBytes + 1) })
