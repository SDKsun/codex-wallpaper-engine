+    return GetWindow(window, 4) == IntPtr.Zero && (IsWindowVisible(window) || IsIconic(window)) &&
+      GetClassName(window, className, className.Capacity) > 0 && className.ToString() == "Chrome_WidgetWin_1";
+  }
+
+  private static void SetProperties(IntPtr window, int processId, string launcher, string icon, bool requireChrome,
