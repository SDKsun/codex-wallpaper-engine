+      // metadata. Restore only while the original HWND still has its owner.
+      if (IsOwnedWindow(window, processId, requireChrome) && verifyOwner?.Invoke() != false)
+        for (uint index = 0; index < saved; index++)
+        {
+          var key = new PropertyKey { FormatId = PropertyGroup, PropertyId = index + 2 };
+          store.SetValue(ref key, ref previous[index]);
+        }
