+test("native verification requires real drawable readiness, a working stylesheet and the matching revision", async () => {
+  const marker = {ready: true, error: null, transportRevision: "r1", surfaceCount: 2, wallpaperPresent: true};
+  const style = {isConnected: true, sheet: {cssRules: [{}]}};
+  const target = session(); target.dshNativeDesired = true;
+  target.evaluate = async expression => vm.runInNewContext(expression, {
+    window: {__GPT_DSH_NATIVE_STATE__: marker}, innerWidth: 900, innerHeight: 700,
+    location: {protocol: "app:"}, document: {hidden: false, visibilityState: "visible", getElementById: () => style, querySelector: () => ({})},
+  });
+  assert.equal((await verifySession(target, "fixture", null, "r1")).pass, true);
+  style.sheet = null; assert.equal((await verifySession(target, "fixture", null, "r1")).pass, false);
+  style.sheet = {cssRules: [{}]}; marker.ready = false; assert.equal((await verifySession(target, "fixture", null, "r1")).pass, false);
+  marker.ready = true; assert.equal((await verifySession(target, "fixture", null, "other")).pass, false);
+  const ownSheet = {cssRules: [{}]};
+  const adoptedStyleSheets = [];
+  style.sheet = null;
+  marker.stylesheetApplied = () => adoptedStyleSheets.includes(ownSheet) && ownSheet.cssRules.length > 0;
+  assert.equal((await verifySession(target, "fixture", null, "r1")).pass, false);
+  adoptedStyleSheets.push({cssRules: [{}]});
+  assert.equal((await verifySession(target, "fixture", null, "r1")).pass, false, "An unrelated adopted sheet is not proof");
+  adoptedStyleSheets.push(ownSheet);
+  assert.equal((await verifySession(target, "fixture", null, "r1")).pass, true, "The owned sheet is adopted and has actual rules");
+  ownSheet.cssRules.length = 0;
+  assert.equal((await verifySession(target, "fixture", null, "r1")).pass, false);
+  ownSheet.cssRules.push({}); style.isConnected = false;
+  assert.equal((await verifySession(target, "fixture", null, "r1")).pass, false);
+  style.isConnected = true;
+  marker.stylesheetApplied = () => ({applied: true});
+  assert.equal((await verifySession(target, "fixture", null, "r1")).pass, false, "A truthy object must not satisfy physical evidence");
+  marker.stylesheetApplied = () => "true";
+  assert.equal((await verifySession(target, "fixture", null, "r1")).pass, false);
+});
