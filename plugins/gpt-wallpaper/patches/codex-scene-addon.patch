+[CmdletBinding()]
+param([Parameter(Mandatory=$true)][string]$Root)
+$ErrorActionPreference='Stop'
+# The manager runs its native bridge in Windows PowerShell 5.1. Hosted build
+# gates may start in pwsh; exercise that same ErrorRecord-based native runtime.
+if($PSVersionTable.PSVersion.Major -ge 6){
+  $windowsPowerShell=Join-Path $env:SystemRoot 'System32/WindowsPowerShell/v1.0/powershell.exe'
+  & $windowsPowerShell -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File $PSCommandPath -Root $Root
+  if($LASTEXITCODE -ne 0){throw 'Windows PowerShell native launch/stream contract tests failed.'}
+  return
+}
+. (Join-Path $Root 'scripts/common-windows.ps1')
+$identityFunction=${function:Get-DreamSkinManagedWindowIdentity}
+$codex=[pscustomobject]@{Executable='C:\fixture\ChatGPT.exe'}
+$profile='C:\fixture\managed profile 中文'
+# Parsing is the real Windows argv parser. No windows are enumerated or changed.
+$parsed=@(Get-DreamSkinManagedWindowArguments -CommandLine ('"C:\fixture\ChatGPT.exe" "--user-data-dir='+$profile+'" --remote-debugging-port=9335'))
+if($parsed.Count -ne 3 -or $parsed[1] -cne ('--user-data-dir='+$profile)){throw 'Quoted Unicode profile argv changed'}
+# Real Codex roots expose auxiliary Chromium HWNDs as well as their main
+# window. Feed the observed three-window shape through the actual native
+# classifier without enumerating or acting on any desktop window.
+$capturedMetadata=@(
+  [pscustomobject]@{name='main';captionLength=7;extendedStyle=0x200008},
+  [pscustomobject]@{name='tool';captionLength=7;extendedStyle=0x200088},
+  [pscustomobject]@{name='nameless';captionLength=0;extendedStyle=0x200008}
+)
+$applicationWindows=@($capturedMetadata|Where-Object {
+  [DreamSkin.ManagedWindow]::IsApplicationWindow(10,10,$true,$false,$false,$true,'Chrome_WidgetWin_1',$_.captionLength,$_.extendedStyle)
+})
+if($applicationWindows.Count -ne 1 -or $applicationWindows[0].name -cne 'main'){
+  throw 'Chromium auxiliary HWNDs made one hidden application window look ambiguous.'
+}
+if([DreamSkin.ManagedWindow]::IsApplicationWindow(20,10,$true,$true,$false,$true,'Chrome_WidgetWin_1',7,0) -or
+   [DreamSkin.ManagedWindow]::IsApplicationWindow(10,10,$false,$true,$false,$true,'Chrome_WidgetWin_1',7,0) -or
+   [DreamSkin.ManagedWindow]::IsApplicationWindow(10,10,$true,$false,$false,$false,'Chrome_WidgetWin_1',7,0) -or
+   [DreamSkin.ManagedWindow]::IsApplicationWindow(10,10,$true,$true,$false,$true,'OtherWindowClass',7,0)){
+  throw 'Wrong-owner, owned-popup, hidden-without-opt-in or unrelated-class metadata was accepted.'
+}
+if(-not [DreamSkin.ManagedWindow]::IsApplicationWindow(10,10,$true,$true,$false,$false,'Chrome_WidgetWin_1',7,0) -or
+   -not [DreamSkin.ManagedWindow]::IsApplicationWindow(10,10,$true,$false,$true,$false,'Chrome_WidgetWin_1',7,0)){
+  throw 'A visible or minimized application window was lost during auxiliary-window filtering.'
+}
