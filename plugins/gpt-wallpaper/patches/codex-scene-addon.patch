+      var success = JsonSerializer.Serialize(new { schema = 1, closed = true, takenOver = true,
+        processId = fresh.ProcessId, startedAt = fresh.StartedAt.ToString("O"), closeRequested = true, windowRestored = false });
+      if (!Regex.IsMatch(fresh.StartedAt.UtcDateTime.ToString("O"), @"\A\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{7}Z\z")) return false;
