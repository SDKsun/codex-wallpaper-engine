+          if (event.detail.phase === "chunk" && autoAck) queueMicrotask(() => { void binding.handleCalled({name: DSH_NATIVE_BINDING, executionContextId: 1, payload: JSON.stringify({op: "ack", id: event.detail.id, index: event.detail.index})}); });
