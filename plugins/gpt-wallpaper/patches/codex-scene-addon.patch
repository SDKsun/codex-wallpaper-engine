+        // independently brokered wallpaper service may already be healthy.
+        try { if (!process.HasExited) process.Kill(); }
+        catch (InvalidOperationException) { }
+        throw new TimeoutException("壁纸资源服务启动超时，请稍后重试或打开管理器查看诊断。");
+      }
+      var drained = Task.WhenAll(stdout, stderr);
+      if (await Task.WhenAny(drained, Task.Delay(500)).ConfigureAwait(false) == drained)
+        await drained.ConfigureAwait(false);
