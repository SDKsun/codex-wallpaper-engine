+# Exercise native stderr ErrorRecords in real Windows PowerShell, then run only
+# the startup JSON predicates extracted from its AST (never the app lifecycle).
+$parseTokens=$null;$parseErrors=$null
+$startupAst=[Management.Automation.Language.Parser]::ParseFile((Join-Path $Root 'scripts/start-dream-skin.ps1'),[ref]$parseTokens,[ref]$parseErrors)
+foreach($functionName in @('Get-DreamSkinVerificationOutput','Test-DreamSkinHiddenVerificationOutput','Test-DreamSkinRenderedVerificationOutput')){
+  $definition=$startupAst.Find({param($node);$node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -ceq $functionName},$true)
