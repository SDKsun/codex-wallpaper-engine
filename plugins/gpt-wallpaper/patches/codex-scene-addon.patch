+    var iid = PropertyStoreId;
+    Marshal.ThrowExceptionForHR(SHGetPropertyStoreForWindow(window, ref iid, out var store));
+    var previous = new PropVariant[4];
+    var saved = 0;
+    try
+    {
+      for (uint id = 2; id <= 5; id++)
+      {
+        var key = new PropertyKey { FormatId = PropertyGroup, PropertyId = id };
+        Marshal.ThrowExceptionForHR(store.GetValue(ref key, out previous[id - 2]));
+        saved++;
+      }
+      // ID must be last: setting it notifies the shell to refresh the group.
+      SetString(store, 2, '"' + launcher + "\" --launch");
+      SetString(store, 3, icon + ",0");
+      SetString(store, 4, "Codex（装扮）");
+      if (!IsOwnedWindow(window, processId, requireChrome) || verifyOwner?.Invoke() == false)
+        throw new InvalidOperationException("Window identity changed.");
+      SetString(store, 5, appId);
+    }
+    catch
+    {
