+  private static async Task<ProcessResult> RunLibraryCommandAsync(ProcessStartInfo info, TimeSpan timeout)
+  {
+    var process = new Process { StartInfo = info };
+    var output = new StringBuilder();
+    var error = new StringBuilder();
+    var drainCancellation = new CancellationTokenSource();
+    try
+    {
+      process.Start();
+      var stdout = PumpBoundedAsync(process.StandardOutput, output, drainCancellation.Token);
+      var stderr = PumpBoundedAsync(process.StandardError, error, drainCancellation.Token);
+      using var deadline = new CancellationTokenSource(timeout);
+      try { await process.WaitForExitAsync(deadline.Token).ConfigureAwait(false); }
+      catch (OperationCanceledException) when (deadline.IsCancellationRequested)
+      {
