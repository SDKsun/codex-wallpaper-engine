+using System.Diagnostics;
+using System.Globalization;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Text.Json;
+
+namespace CodexDreamSkin.Manager;
+
+// Window-local relaunch metadata keeps a pin made from a decorated Codex
+// window on the decorated launch path. It does not replace the Store app,
+// its protocol registration, or pins made from an unrelated normal window.
+internal static class TaskbarRelaunch
+{
+  internal const string AppId = "CodexWallpaperEngine.Codex";
+  private static readonly Guid PropertyGroup = new("9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3");
+  private static readonly Guid PropertyStoreId = new("886D8EEB-8CF2-4446-8D02-CDBA1DBDCF99");
+  private sealed record Identity(int ProcessId, DateTimeOffset StartedAt, string BrowserId, string Profile);
+  private sealed record Owner(string Executable, int SessionId);
+
+  public static async Task<bool> ApplyAsync(RuntimeProvisioner runtime, CancellationToken cancellationToken = default)
+  {
+    try
+    {
+      var launcher = ValidLauncherPath(Environment.ProcessPath);
+      if (launcher is null) return false;
+      var first = await ReadIdentityAsync(runtime, cancellationToken);
+      if (first is null) return false;
+      var owner = ReadOwner(first);
+      if (owner is null) return false;
+      var windows = OwnedWindows(first.ProcessId);
+      if (windows.Count != 1) return false;
+      // The two read-only preflights revalidate the registered Store executable,
+      // sole loopback CDP listener, browser UUID and exact managed profile.
+      var current = await ReadIdentityAsync(runtime, cancellationToken);
+      if (current != first || ReadOwner(first) != owner || !OwnedWindows(first.ProcessId).SequenceEqual(windows) ||
+          !IsOwnedWindow(windows[0], first.ProcessId, requireChrome: true)) return false;
+      SetProperties(windows[0], first.ProcessId, launcher, owner.Executable, requireChrome: true,
+        verifyOwner: () => ReadOwner(first) == owner);
+      return true;
+    }
+    catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
+    catch { return false; }
+  }
+
+  private static async Task<Identity?> ReadIdentityAsync(RuntimeProvisioner runtime, CancellationToken token)
+  {
+    using var bounded = CancellationTokenSource.CreateLinkedTokenSource(token);
+    bounded.CancelAfter(TimeSpan.FromSeconds(15));
+    var result = await new PowerShellRunner(runtime).RunScriptAsync(runtime.StartScript,
+      new[] { "-Port", "9335", "-PreflightOnly" }, bounded.Token, captureOutput: true);
+    return result.ExitCode == 0 ? ParseIdentity(result.StandardOutput, runtime.StateRoot) : null;
+  }
+
+  private static Identity? ParseIdentity(string json, string stateRoot)
+  {
+    if (string.IsNullOrWhiteSpace(json) || json.Length > 8192) return null;
+    try
+    {
+      using var document = JsonDocument.Parse(json);
+      var root = document.RootElement;
+      if (root.ValueKind != JsonValueKind.Object) return null;
+      var fields = root.EnumerateObject().ToArray();
+      var names = new HashSet<string>(StringComparer.Ordinal);
+      foreach (var field in fields)
+        if (!names.Add(field.Name) || field.Name is not ("usableVerifiedCdp" or "port" or "browserId" or
+            "ownerProcessId" or "ownerStartedAt" or "profilePath")) return null;
+      if (fields.Length != 6 || root.GetProperty("usableVerifiedCdp").ValueKind != JsonValueKind.True ||
+          root.GetProperty("port").GetInt32() != 9335) return null;
+      var pid = root.GetProperty("ownerProcessId").GetInt32();
+      var browser = root.GetProperty("browserId").GetString();
+      var startedText = root.GetProperty("ownerStartedAt").GetString();
+      var profile = root.GetProperty("profilePath").GetString();
+      if (pid <= 0 || !Guid.TryParseExact(browser, "D", out _) ||
+          !DateTimeOffset.TryParse(startedText, CultureInfo.InvariantCulture, DateTimeStyles.None, out var started) ||
+          !SafeAbsolutePath(profile) || !string.Equals(Path.GetFullPath(profile!),
+            Path.GetFullPath(Path.Combine(stateRoot, "cdp-profile")), StringComparison.OrdinalIgnoreCase)) return null;
+      return new Identity(pid, started, browser!, Path.GetFullPath(profile!));
+    }
+    catch (Exception exception) when (exception is JsonException or InvalidOperationException or
+        ArgumentException or KeyNotFoundException or FormatException or OverflowException or NotSupportedException)
+    { return null; }
+  }
+
+  private static Owner? ReadOwner(Identity expected)
+  {
+    try
+    {
+      using var process = Process.GetProcessById(expected.ProcessId);
+      using var self = Process.GetCurrentProcess();
+      var executable = process.MainModule?.FileName;
+      if (process.HasExited || process.SessionId != self.SessionId ||
+          Math.Abs((new DateTimeOffset(process.StartTime.ToUniversalTime()) - expected.StartedAt).TotalMilliseconds) > 1 ||
+          !SafeAbsolutePath(executable) || !string.Equals(Path.GetFileName(executable), "ChatGPT.exe", StringComparison.OrdinalIgnoreCase))
+        return null;
+      return new Owner(Path.GetFullPath(executable!), process.SessionId);
+    }
+    catch { return null; }
+  }
+
+  private static bool SafeAbsolutePath(string? value) => !string.IsNullOrWhiteSpace(value) && value.Length < 32700 &&
+    value.IndexOfAny(new[] { '\0', '\r', '\n', '"' }) < 0 && Path.IsPathFullyQualified(value) &&
+    !value.StartsWith(@"\\", StringComparison.Ordinal);
+
+  private static string? ValidLauncherPath(string? path)
+  {
+    if (!SafeAbsolutePath(path) || !string.Equals(Path.GetFileName(path), "CodexDreamSkinManager.exe", StringComparison.OrdinalIgnoreCase))
+      return null;
+    var full = Path.GetFullPath(path!);
+    if (!File.Exists(full)) return null;
+    for (var cursor = full; !string.IsNullOrEmpty(cursor); cursor = Path.GetDirectoryName(cursor))
+      if ((File.GetAttributes(cursor) & FileAttributes.ReparsePoint) != 0) return null;
+    return full;
+  }
+
+  private static List<IntPtr> OwnedWindows(int processId)
+  {
+    var result = new List<IntPtr>();
+    EnumWindows((window, _) =>
+    {
+      if (IsOwnedWindow(window, processId, requireChrome: true)) result.Add(window);
+      return true;
+    }, IntPtr.Zero);
+    return result;
+  }
+
+  private static bool IsOwnedWindow(IntPtr window, int processId, bool requireChrome)
+  {
+    if (window == IntPtr.Zero || !IsWindow(window)) return false;
