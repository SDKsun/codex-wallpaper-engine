diff --git a/windows/app/CodexDreamSkin.Manager/StartupAssistant.cs b/windows/app/CodexDreamSkin.Manager/StartupAssistant.cs
new file mode 100644
index 0000000..7b96646
--- /dev/null
+++ b/windows/app/CodexDreamSkin.Manager/StartupAssistant.cs
@@ -0,0 +1,779 @@
+using System.Diagnostics;
+using System.Globalization;
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace CodexDreamSkin.Manager;
+
+// Explicitly enabled by the assistant installer. The normal manager and
+// --minimized modes do not enable this monitor or change startup preferences.
+internal static class StartupAssistant
+{
+  private const string Caption = "Codex 自动装扮";
+  private const int MaximumJsonBytes = 64 * 1024;
+  private sealed record Settings(bool Enabled, bool Paused, string Launcher, byte[] Bytes);
+  private sealed record Root(int ProcessId, DateTimeOffset StartedAt, string Kind,
+    double AgeSeconds, bool PlainLaunch, bool VisibleWindow)
+  {
+    public string Key => ProcessId.ToString(CultureInfo.InvariantCulture) + ":" + StartedAt.ToString("O");
+  }
+  private sealed record Snapshot(bool OperationBusy, IReadOnlyList<Root> Roots, int RegisteredProcessCount = 0);
+
+  public static int Run()
+  {
+    using var singleton = new Mutex(false, @"Local\CodexDreamSkin.StartupAssistant");
+    var acquired = false;
+    try
+    {
+      try { acquired = singleton.WaitOne(0); }
+      catch (AbandonedMutexException) { acquired = true; }
+      if (!acquired) return 0;
+      var launcher = Environment.ProcessPath ?? throw new InvalidOperationException();
+      RequirePlainPath(launcher, file: true);
+      var settingsPath = Path.Combine(ManagerLocalData.Root, "GPTWallpaper", "startup-assistant.json");
+      var settings = ReadSettings(settingsPath, launcher);
+      RequireActiveInstallation(Path.Combine(Path.GetDirectoryName(settingsPath)!, "startup-assistant-install.json"), launcher);
+      if (!settings.Enabled) return 0;
+      var bridge = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "..", "scripts", "assistant-command.ps1"));
+      RequirePlainPath(bridge, file: true);
+      var runtime = new RuntimeProvisioner();
+      runtime.EnsureHelperRuntime();
+      Application.SetHighDpiMode(HighDpiMode.PerMonitorV2);
+      Application.EnableVisualStyles();
+      Application.SetCompatibleTextRenderingDefault(false);
+      using var context = new MonitorContext(runtime, bridge, settingsPath, launcher);
+      Application.Run(context);
+      return 0;
+    }
+    catch
+    {
+      MessageBox.Show("自动装扮助手未能启动，请打开壁纸设置查看或重新安装助手。Codex 未被接管。",
+        Caption, MessageBoxButtons.OK, MessageBoxIcon.Warning);
+      return 1;
+    }
+    finally { if (acquired) singleton.ReleaseMutex(); }
+  }
+
+  private sealed class MonitorContext : ApplicationContext
+  {
+    private readonly RuntimeProvisioner _runtime;
+    private readonly PowerShellRunner _runner;
+    private readonly string _bridge, _settingsPath, _launcher, _journal, _statusPath;
+    private readonly Controller _controller = new();
+    private readonly System.Windows.Forms.Timer _timer = new() { Interval = 1000 };
+    private readonly CancellationTokenSource _lifetime = new();
+    private readonly NotifyIcon _tray;
+    private readonly ContextMenuStrip _menu = new();
+    private readonly ToolStripMenuItem _pause = new("暂停自动装扮");
+    private readonly HashSet<string> _reported = new(StringComparer.Ordinal);
+    private Task? _resources;
+    private bool _busy, _takeoverInFlight, _exitRequested, _suppressed, _disposed;
+    private bool? _lastPaused;
+    private int _failures;
+    private DateTimeOffset _nextProbe;
+    private readonly DateTimeOffset _startedAt = new(Process.GetCurrentProcess().StartTime.ToUniversalTime());
+    private Root? _candidate;
+    private int? _lastLauncherExitCode;
+    private string? _lastErrorCode, _lastStatus;
+
+    public MonitorContext(RuntimeProvisioner runtime, string bridge, string settingsPath, string launcher)
+    {
+      _runtime = runtime; _bridge = bridge; _settingsPath = settingsPath; _launcher = launcher;
+      _journal = Path.Combine(ManagerLocalData.Root, "GPTWallpaper", "startup-assistant.log");
+      _statusPath = Path.Combine(ManagerLocalData.Root, "GPTWallpaper", "startup-assistant-status.json");
+      _runner = new PowerShellRunner(runtime);
+      _tray = new NotifyIcon { Icon = SystemIcons.Application, Text = Caption,
+        ContextMenuStrip = _menu, Visible = true };
+      var settings = new ToolStripMenuItem("打开壁纸设置");
+      settings.Click += (_, _) => OpenSettings();
+      _pause.Click += (_, _) => TogglePause();
+      var exit = new ToolStripMenuItem("关闭自动装扮并退出");
+      exit.Click += (_, _) => RequestExit();
+      _menu.Items.AddRange(new ToolStripItem[] { settings, _pause, new ToolStripSeparator(), exit });
+      _tray.DoubleClick += (_, _) => OpenSettings();
+      _timer.Tick += async (_, _) => await TickAsync();
+      Journal("assistant_started");
+      WriteStatus("watching");
+      _timer.Start();
+    }
+
+    private async Task TickAsync()
+    {
+      if (_busy || _exitRequested || DateTimeOffset.UtcNow < _nextProbe) return;
+      _busy = true;
+      try
+      {
+        var settings = CurrentSettings();
+        if (!settings.Enabled) { ExitThread(); return; }
+        _pause.Checked = settings.Paused || _suppressed;
+        _pause.Text = _pause.Checked ? "恢复自动装扮" : "暂停自动装扮";
+        if (_lastPaused != settings.Paused)
+        {
+          if (_lastPaused == true && !settings.Paused) _controller.OnlyFutureLaunches(DateTimeOffset.UtcNow);
+          _lastPaused = settings.Paused;
+          Journal(settings.Paused ? "assistant_paused" : "assistant_ready");
+        }
+        // Resource initialization runs asynchronously while snapshots continue
+        // observing the fresh process window. It never closes or launches Codex.
+        if (!settings.Paused && !_suppressed && _resources is null)
+          _resources = CodexLauncher.EnsureLibraryAsync(_runtime);
+        var snapshot = await ReadSnapshotAsync();
+        foreach (var reason in _controller.Observe(snapshot, DateTimeOffset.UtcNow)) Journal(reason);
+        if (settings.Paused || _suppressed)
+        {
+          // A resume affects later launches, not windows opened while paused.
+          _controller.Ignore(snapshot);
+          WriteStatus("paused");
+          return;
+        }
+        WriteStatus("watching");
+        if (_resources is null || !_resources.IsCompleted) return;
+        await _resources;
+        _lifetime.Token.ThrowIfCancellationRequested();
+        _failures = 0;
+        var candidate = _controller.Select(snapshot, DateTimeOffset.UtcNow);
+        if (candidate is null) return;
+        var current = CurrentSettings();
+        if (!current.Enabled || current.Paused || _exitRequested) return;
+        _controller.Attempt(candidate);
+        _candidate = candidate; _lastLauncherExitCode = null; _lastErrorCode = null;
+        _takeoverInFlight = true;
+        Journal("takeover_requested");
+        WriteStatus("takeover");
+        // This bridge only acts on the captured root/descendant identities. It
+        // never spawns Codex; cancellation cannot kill an application child tree.
+        var response = await InvokeBridgeAsync(new[] { "-Action", "Takeover",
+          "-ExpectedProcessId", candidate.ProcessId.ToString(CultureInfo.InvariantCulture),
+          "-ExpectedStartedAt", candidate.StartedAt.UtcDateTime.ToString("O") },
+          TimeSpan.FromSeconds(35), includeLifetime: false);
+        if (!ReadTakeover(response, candidate, out var reasonCode, out var closeRequested, out var windowRestored))
+        {
+          if (_controller.Retry(candidate, reasonCode, closeRequested, DateTimeOffset.UtcNow))
+          {
+            Journal("takeover_retry_" + reasonCode);
+            WriteStatus("watching");
+            return;
+          }
+          if (!closeRequested || windowRestored)
+          {
+            Report("takeover_" + reasonCode, windowRestored
+              ? "本次自动接入未完成，已恢复原 Codex 窗口。"
+              : "本次自动接入未完成，原 Codex 会话已保留。");
+            return;
+          }
+          // WM_CLOSE can finish successfully while a later tree check races.
+          // Recover only when every registered application process is gone;
+          // roots alone exclude renderer/utility orphans. The launcher repeats
+          // its own strict preflight and never receives RestartExisting here.
+          var recovery = await ReadSnapshotAsync();
+          if (recovery.OperationBusy || recovery.RegisteredProcessCount != 0 || recovery.Roots.Count != 0)
+          {
+            Report("takeover_" + reasonCode,
+              "自动接入已停止，仍在运行的 Codex 进程已保留；请从原图标恢复窗口。");
+            return;
+          }
+          Journal("takeover_recovered_after_exit");
+        }
+        else Journal("takeover_closed_exact_root");
+        // Pause/uninstall revokes consent immediately, even if the narrowly
+        // scoped close already completed. Do not start another application
+        // after revocation; the user can reopen Codex normally in that race.
+        var afterClose = CurrentSettings();
+        if (!afterClose.Enabled || afterClose.Paused || _exitRequested || _suppressed)
+        {
+          Journal("launch_skipped_after_consent_revoked");
+          WriteStatus("paused");
+          return;
+        }
+        var child = StartLauncher();
+        WriteStatus("launching");
+        _tray.Text = Caption + "：正在启动";
+        _tray.ShowBalloonTip(3000, Caption, "正在重新打开 Codex 并恢复已保存的装扮。", ToolTipIcon.Info);
+        _takeoverInFlight = false;
+        if (_exitRequested) { child.Dispose(); ExitThread(); return; }
+        using (child)
+        using (var wait = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token))
+        {
+          wait.CancelAfter(TimeSpan.FromSeconds(330));
+          try { await child.WaitForExitAsync(wait.Token); }
+          catch (OperationCanceledException) when (!_lifetime.IsCancellationRequested)
+          {
+            Suppress("launch_wait_timeout", "装扮启动仍在进行，已暂停后续自动接管。当前启动进程会继续运行。");
+            return;
+          }
+          if (child.ExitCode != 0)
+          {
+            _lastLauncherExitCode = child.ExitCode;
+            // This identity has already been attempted. Preserve the error,
+            // but keep watching later user launches instead of silently
+            // persisting a global pause after one transient command failure.
+            Report("launch_failed", "本次自动装扮未完成。助手会等待下一次正常启动，详细原因见壁纸诊断。");
+            _nextProbe = DateTimeOffset.UtcNow.AddSeconds(2);
+            return;
+          }
+          _lastLauncherExitCode = 0;
+        }
+        // Do not infer video/FPS success from this status. --launch owns its
+        // native verification and the helper only reports that command result.
+        Journal("launch_command_completed");
+        WriteStatus("ready");
+        _tray.Text = Caption + "：等待下次启动";
+        _failures = 0;
+      }
+      catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
+      catch
+      {
+        // A failed warm-up is not a permanently poisoned task. Retry the
+        // read-only resource preflight with bounded backoff; no process is
+        // closed until a later warm-up completes successfully.
+        if (_resources?.IsFaulted == true) { _ = _resources.Exception; _resources = null; }
+        _failures++;
+        _nextProbe = DateTimeOffset.UtcNow + RetryDelay(_failures);
+        Report("assistant_operation_failed", "自动装扮暂时无法完成，请打开壁纸设置查看。");
+        if (_failures >= 3) Suppress("assistant_paused_after_errors", "自动装扮已因连续错误暂停，请从托盘恢复。");
+      }
+      finally
+      {
+        _takeoverInFlight = false;
+        _busy = false;
+        if (_exitRequested && !_disposed) ExitThread();
+      }
+    }
+
+    private async Task<Snapshot> ReadSnapshotAsync() => ParseSnapshot(await InvokeBridgeAsync(
+      new[] { "-Action", "Snapshot" }, TimeSpan.FromSeconds(10), includeLifetime: true));
+
+    private async Task<string> InvokeBridgeAsync(string[] arguments, TimeSpan timeout, bool includeLifetime)
+    {
+      RequirePlainPath(_bridge, file: true);
+      using var operation = includeLifetime
+        ? CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token)
+        : new CancellationTokenSource();
+      operation.CancelAfter(timeout);
+      var result = await _runner.RunScriptAsync(_bridge, arguments, operation.Token, captureOutput: true);
+      if (result.ExitCode != 0 || Encoding.UTF8.GetByteCount(result.StandardOutput) > MaximumJsonBytes)
+        throw new InvalidOperationException("Assistant bridge failed.");
+      return result.StandardOutput;
+    }
+
+    private Process StartLauncher()
+    {
+      RequirePlainPath(_launcher, file: true);
+      var info = new ProcessStartInfo { FileName = _launcher, UseShellExecute = false,
+        CreateNoWindow = true, WorkingDirectory = Path.GetDirectoryName(_launcher)! };
+      info.ArgumentList.Add("--launch");
+      info.ArgumentList.Add("--non-interactive");
+      info.Environment["LOCALAPPDATA"] = ManagerLocalData.Root;
+      info.Environment["CODEX_DREAM_SKIN_LOCAL_APPDATA"] = ManagerLocalData.Root;
+      return Process.Start(info) ?? throw new InvalidOperationException("Launcher did not start.");
+    }
+
+    private void OpenSettings()
+    {
+      try
+      {
+        RequirePlainPath(_launcher, file: true);
+        Process.Start(new ProcessStartInfo { FileName = _launcher, UseShellExecute = false,
+          WorkingDirectory = Path.GetDirectoryName(_launcher)!, CreateNoWindow = true })?.Dispose();
+      }
+      catch { Report("settings_open_failed", "壁纸设置无法打开，请检查助手安装。"); }
+    }
+
+    private void TogglePause()
+    {
+      try
+      {
+        var current = CurrentSettings();
+        var paused = !(current.Paused || _suppressed);
+        WriteSettings(_settingsPath, current with { Paused = paused });
+        _suppressed = false; _failures = 0; _nextProbe = default;
+        if (!paused) _reported.Clear();
+        if (!paused && _resources?.IsFaulted == true) { _ = _resources.Exception; _resources = null; }
+        if (!paused) _controller.OnlyFutureLaunches(DateTimeOffset.UtcNow);
+        _pause.Checked = paused;
+        _pause.Text = paused ? "恢复自动装扮" : "暂停自动装扮";
+        Journal(paused ? "assistant_paused_by_user" : "assistant_resumed_by_user");
+        WriteStatus(paused ? "paused" : "watching");
+      }
+      catch (OperationCanceledException) when (_exitRequested) { }
+      catch { Report("settings_save_failed", "未能保存助手设置，本次状态未改变。"); }
+    }
+
+    private void RequestExit()
+    {
+      try
+      {
+        var settings = CurrentSettings();
+        WriteSettings(_settingsPath, settings with { Enabled = false });
+        Journal("assistant_disabled_by_user");
+        WriteStatus("paused");
+        _exitRequested = true;
+        _timer.Stop();
+        if (_takeoverInFlight)
+          Report("assistant_exit_deferred", "已撤销自动接管，等待当前检查结束后退出。");
+        else ExitThread();
+      }
+      catch (OperationCanceledException) when (_exitRequested) { }
+      catch
+      {
+        _suppressed = true;
+        Report("disable_save_failed", "停止状态未能保存，助手已暂停，请从壁纸设置关闭。");
+      }
+    }
+
+    private void Suppress(string code, string message)
+    {
+      _suppressed = true;
+      try
+      {
+        var settings = CurrentSettings();
+        WriteSettings(_settingsPath, settings with { Paused = true });
+      }
+      catch (OperationCanceledException) when (_exitRequested) { return; }
+      catch { Journal("pause_save_failed"); }
+      _pause.Checked = true; _pause.Text = "恢复自动装扮";
+      Report(code, message);
+    }
+
+    private Settings CurrentSettings()
+    {
+      try
+      {
+        RequireActiveInstallation(Path.Combine(Path.GetDirectoryName(_settingsPath)!, "startup-assistant-install.json"), _launcher);
+        return ReadSettings(_settingsPath, _launcher);
+      }
+      catch
+      {
+        // An uninstall or a content-version upgrade revokes this executable's
+        // authority. Release the singleton so the new helper can take over;
+        // malformed settings must never leave an old monitor holding it.
+        Journal("assistant_configuration_revoked");
+        WriteStatus("paused");
+        _exitRequested = true;
+        ExitThread();
+        throw new OperationCanceledException();
+      }
+    }
+
+    private void Report(string code, string message)
+    {
+      _lastErrorCode = Regex.IsMatch(code, @"\A[a-z0-9_]{1,96}\z") ? code : "unknown_error";
+      Journal(code);
+      WriteStatus("failed");
+      if (_disposed || !_reported.Add(code)) return;
+      _tray.Text = Caption + "：需要查看";
+      _tray.ShowBalloonTip(5000, Caption, message, ToolTipIcon.Warning);
+    }
+
+    private void WriteStatus(string phase)
+    {
+      try
+      {
+        RequirePlainPath(Path.GetDirectoryName(_statusPath)!, file: false);
+        if (File.Exists(_statusPath)) RequirePlainPath(_statusPath, file: true);
+        var json = JsonSerializer.Serialize(new { schema = 1, pid = Environment.ProcessId,
+          startedAt = _startedAt.UtcDateTime.ToString("O"), phase, candidatePid = _candidate?.ProcessId,
+          candidateStartedAt = _candidate?.StartedAt.UtcDateTime.ToString("O"), lastLauncherExitCode = _lastLauncherExitCode,
+          lastErrorCode = _lastErrorCode });
+        if (json == _lastStatus) return;
+        var temporary = _statusPath + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try { File.WriteAllText(temporary, json, new UTF8Encoding(false)); File.Move(temporary, _statusPath, true); }
+        finally { if (File.Exists(temporary)) File.Delete(temporary); }
+        _lastStatus = json;
+      }
+      catch { Journal("status_write_failed"); }
+    }
+
+    private void Journal(string code)
+    {
+      // Never journal argv, paths, service URLs, bridge output or exceptions.
+      if (!Regex.IsMatch(code, @"\A[a-z0-9_]{1,96}\z")) code = "unknown_error";
+      try
+      {
+        RequirePlainPath(Path.GetDirectoryName(_journal)!, file: false);
+        var lines = new List<string>();
+        if (File.Exists(_journal))
+        {
+          RequirePlainPath(_journal, file: true);
+          if (new FileInfo(_journal).Length <= 32768)
+            lines.AddRange(File.ReadAllLines(_journal).TakeLast(49));
+        }
+        lines.Add(DateTimeOffset.UtcNow.ToString("O") + " " + code);
+        File.WriteAllLines(_journal, lines, new UTF8Encoding(false));
+      }
+      catch { }
+    }
+
+    protected override void ExitThreadCore()
+    {
+      _timer.Stop();
+      _lifetime.Cancel();
+      base.ExitThreadCore();
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+      if (disposing && !_disposed)
+      {
+        _disposed = true; _timer.Stop(); _lifetime.Cancel();
+        _tray.Visible = false; _tray.Dispose(); _menu.Dispose(); _timer.Dispose();
+        _lifetime.Dispose();
+      }
+      base.Dispose(disposing);
+    }
+  }
+
+  private static TimeSpan RetryDelay(int failures) =>
+    TimeSpan.FromSeconds(15 * (1 << Math.Clamp(failures - 1, 0, 2)));
+
+  private sealed class Controller
+  {
+    private readonly HashSet<string> _attempted = new(StringComparer.Ordinal);
+    private readonly Dictionary<string, int> _attemptCounts = new(StringComparer.Ordinal);
+    private readonly Dictionary<string, DateTimeOffset> _retryAfter = new(StringComparer.Ordinal);
+    private readonly HashSet<string> _observedExclusions = new(StringComparer.Ordinal);
+    private DateTimeOffset? _notBefore;
+
+    public IEnumerable<string> Observe(Snapshot snapshot, DateTimeOffset now)
+    {
+      foreach (var root in snapshot.Roots)
+      {
+        string? reason = root.Kind == "unknown" ? "unknown_root_preserved"
+          : root.Kind == "normal" && !root.PlainLaunch ? "argument_launch_preserved"
+          : root.Kind == "normal" && !Fresh(root, now) ? "older_root_preserved" : null;
+        if (reason is not null)
+        {
+          _attempted.Add(root.Key);
+          if (_observedExclusions.Add(root.Key)) yield return reason;
+        }
+      }
+    }
+
+    public Root? Select(Snapshot snapshot, DateTimeOffset now)
+    {
+      if (snapshot.OperationBusy) return null;
+      foreach (var root in snapshot.Roots)
+      {
+        if (root.Kind != "normal" || !root.PlainLaunch || !root.VisibleWindow ||
+            !Fresh(root, now) || (_notBefore.HasValue && root.StartedAt <= _notBefore.Value) ||
+            _attempted.Contains(root.Key) ||
+            (_retryAfter.TryGetValue(root.Key, out var retryAt) && now < retryAt)) continue;
+        if (snapshot.Roots.Any(other => other.Key != root.Key && other.Kind is "normal" or "unknown"))
+          continue;
+        return root;
+      }
+      return null;
+    }
+    public void Attempt(Root root)
+    {
+      _attempted.Add(root.Key);
+      _attemptCounts[root.Key] = _attemptCounts.GetValueOrDefault(root.Key) + 1;
+      _retryAfter.Remove(root.Key);
+    }
+    public bool Retry(Root root, string reason, bool closeRequested, DateTimeOffset now)
+    {
+      // Retry only a refusal that happened before any close. An admitted
+      // process retains the original 15-second window and three-attempt cap.
+      if (closeRequested || !Fresh(root, now) ||
+          reason is not ("operation_busy" or "not_visible" or "tree_changed" or "close_refused") ||
+          _attemptCounts.GetValueOrDefault(root.Key) is not (> 0 and < 3)) return false;
+      _attempted.Remove(root.Key);
+      _retryAfter[root.Key] = now.AddSeconds(1);
+      return true;
+    }
+    public void OnlyFutureLaunches(DateTimeOffset after) => _notBefore = after;
+    public void Ignore(Snapshot snapshot) { foreach (var root in snapshot.Roots) _attempted.Add(root.Key); }
+    private static bool Fresh(Root root, DateTimeOffset now) => root.AgeSeconds <= 15 &&
+      root.StartedAt <= now && now - root.StartedAt <= TimeSpan.FromSeconds(15);
+  }
+
+  private static void Fields(JsonElement element, params string[] expected)
+  {
+    if (element.ValueKind != JsonValueKind.Object) throw new JsonException();
+    var fields = element.EnumerateObject().Select(property => property.Name).ToArray();
+    if (fields.Length != expected.Length || fields.Distinct(StringComparer.Ordinal).Count() != fields.Length ||
+        fields.Any(name => !expected.Contains(name, StringComparer.Ordinal))) throw new JsonException();
+  }
+  private static bool Boolean(JsonElement root, string name) => root.GetProperty(name).ValueKind switch
+  { JsonValueKind.True => true, JsonValueKind.False => false, _ => throw new JsonException() };
+  private static DateTimeOffset StartTime(JsonElement root)
+  {
+    var text = root.GetProperty("startedAt").GetString();
+    if (text is null || text.Length > 64 || !DateTimeOffset.TryParse(text, CultureInfo.InvariantCulture,
+      DateTimeStyles.None, out var value) || value.Offset != TimeSpan.Zero) throw new JsonException();
+    return value;
+  }
+
+  private static Snapshot ParseSnapshot(string json)
+  {
+    if (Encoding.UTF8.GetByteCount(json) > MaximumJsonBytes) throw new JsonException();
+    using var document = JsonDocument.Parse(json.TrimStart('\uFEFF'), new JsonDocumentOptions { MaxDepth = 5 });
+    var root = document.RootElement;
+    Fields(root, "schema", "operationBusy", "registeredProcessCount", "roots");
+    if (root.GetProperty("schema").GetInt32() != 1) throw new JsonException();
+    var busy = Boolean(root, "operationBusy");
+    var array = root.GetProperty("roots");
+    if (array.ValueKind != JsonValueKind.Array || array.GetArrayLength() > 64) throw new JsonException();
+    var processes = new List<Root>();
+    var ids = new HashSet<int>();
+    foreach (var item in array.EnumerateArray())
+    {
+      Fields(item, "processId", "startedAt", "kind", "ageSeconds", "plainLaunch", "visibleWindow");
+      var id = item.GetProperty("processId").GetInt32();
+      var kind = item.GetProperty("kind").GetString();
+      var age = item.GetProperty("ageSeconds").GetDouble();
+      if (id <= 0 || !ids.Add(id) || kind is not ("normal" or "managed" or "unknown") ||
+          !double.IsFinite(age) || age < 0) throw new JsonException();
+      processes.Add(new Root(id, StartTime(item), kind, age, Boolean(item, "plainLaunch"), Boolean(item, "visibleWindow")));
+    }
+    var registeredCount = root.GetProperty("registeredProcessCount").GetInt32();
+    if (registeredCount < processes.Count || registeredCount > 8192) throw new JsonException();
+    return new Snapshot(busy, processes, registeredCount);
+  }
+
+  private static bool ReadTakeover(string json, Root expected, out string reason,
+    out bool closeRequested, out bool windowRestored)
+  {
+    reason = "rejected";
+    closeRequested = false; windowRestored = false;
+    if (Encoding.UTF8.GetByteCount(json) > 8192) throw new JsonException();
+    using var document = JsonDocument.Parse(json.TrimStart('\uFEFF'), new JsonDocumentOptions { MaxDepth = 3 });
+    var root = document.RootElement;
+    if (root.TryGetProperty("reason", out var code))
+    {
+      Fields(root, "schema", "closed", "takenOver", "processId", "startedAt", "reason", "closeRequested", "windowRestored");
+      if (root.GetProperty("schema").GetInt32() != 1 || Boolean(root, "closed") || Boolean(root, "takenOver"))
+        throw new JsonException();
+      if (root.GetProperty("processId").GetInt32() != expected.ProcessId || StartTime(root) != expected.StartedAt)
+        throw new JsonException();
+      reason = code.GetString() ?? "rejected";
+      if (!Regex.IsMatch(reason, @"\A[a-z0-9_]{1,64}\z")) throw new JsonException();
+      closeRequested = Boolean(root, "closeRequested");
+      windowRestored = Boolean(root, "windowRestored");
+      if (windowRestored && !closeRequested) throw new JsonException();
+      return false;
+    }
+    Fields(root, "schema", "closed", "takenOver", "processId", "startedAt", "closeRequested", "windowRestored");
+    closeRequested = Boolean(root, "closeRequested");
+    windowRestored = Boolean(root, "windowRestored");
+    return root.GetProperty("schema").GetInt32() == 1 && Boolean(root, "closed") && Boolean(root, "takenOver") &&
+      closeRequested && !windowRestored && root.GetProperty("processId").GetInt32() == expected.ProcessId && StartTime(root) == expected.StartedAt;
+  }
+
+  private static Settings ReadSettings(string file, string expectedLauncher)
+  {
+    RequirePlainPath(file, file: true);
+    if (new FileInfo(file).Length > 8192) throw new JsonException();
+    var bytes = File.ReadAllBytes(file);
+    using var document = JsonDocument.Parse(bytes, new JsonDocumentOptions { MaxDepth = 2 });
+    var root = document.RootElement;
+    Fields(root, "schema", "enabled", "paused", "launcherPath");
+    var launcher = root.GetProperty("launcherPath").GetString();
+    if (root.GetProperty("schema").GetInt32() != 1 || launcher is null ||
+        !string.Equals(Path.GetFullPath(launcher), Path.GetFullPath(expectedLauncher), StringComparison.OrdinalIgnoreCase))
+      throw new JsonException();
+    RequirePlainPath(launcher, file: true);
+    return new Settings(Boolean(root, "enabled"), Boolean(root, "paused"), launcher, bytes);
+  }
+
+  private static void RequireActiveInstallation(string file, string launcher)
+  {
+    RequirePlainPath(file, file: true);
+    if (new FileInfo(file).Length > MaximumJsonBytes) throw new JsonException();
+    using var document = JsonDocument.Parse(File.ReadAllBytes(file), new JsonDocumentOptions { MaxDepth = 6 });
+    var root = document.RootElement;
+    if (root.ValueKind != JsonValueKind.Object ||
+        root.EnumerateObject().Select(item => item.Name).Distinct(StringComparer.Ordinal).Count() != root.EnumerateObject().Count() ||
+        root.GetProperty("schema").GetInt32() != 1 ||
+        root.GetProperty("product").GetString() != "codex-wallpaper-startup-assistant" ||
+        !Boolean(root, "active")) throw new JsonException();
+    var run = root.GetProperty("ownedRun");
+    if (run.ValueKind != JsonValueKind.Object ||
+        run.EnumerateObject().Select(item => item.Name).Distinct(StringComparer.Ordinal).Count() != run.EnumerateObject().Count() ||
+        !Boolean(run, "exists") || run.GetProperty("kind").GetString() != "String" ||
+        run.GetProperty("value").GetString() != '"' + launcher + "\" --assistant") throw new JsonException();
+  }
+
+  private static void WriteSettings(string file, Settings settings)
+  {
+    RequirePlainPath(file, file: true);
+    var directory = Path.GetDirectoryName(file)!;
+    var temporary = Path.Combine(directory, ".assistant-" + Guid.NewGuid().ToString("N") + ".tmp");
+    try
+    {
+      var json = JsonSerializer.Serialize(new { schema = 1, enabled = settings.Enabled,
+        paused = settings.Paused, launcherPath = settings.Launcher });
+      File.WriteAllText(temporary, json, new UTF8Encoding(false));
+      if (!File.ReadAllBytes(file).SequenceEqual(settings.Bytes)) throw new IOException("Settings changed.");
+      File.Replace(temporary, file, null);
+    }
+    finally { if (File.Exists(temporary)) File.Delete(temporary); }
+  }
+
+  private static void RequirePlainPath(string path, bool file)
+  {
+    if (string.IsNullOrWhiteSpace(path) || path.Length > 32700 || !Path.IsPathFullyQualified(path) ||
+        path.StartsWith(@"\\", StringComparison.Ordinal) || path.IndexOfAny(new[] { '\0', '\r', '\n', '"' }) >= 0 ||
+        (file ? !File.Exists(path) : !Directory.Exists(path))) throw new IOException("Invalid helper path.");
+    for (var current = Path.GetFullPath(path); !string.IsNullOrEmpty(current); current = Path.GetDirectoryName(current))
+      if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0) throw new IOException("Linked helper path.");
+  }
+
+  internal static bool HelperRuntimeSelfTest()
+  {
+    var fixture = Path.Combine(Path.GetTempPath(), "codex-helper-runtime-test-" + Guid.NewGuid().ToString("N"));
